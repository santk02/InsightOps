# Database
DATABASE_URL=postgresql://insightops:insightops@localhost:5432/insightops
DATABASE_RO_URL=postgresql://analytics_ro:analytics_ro_pass@localhost:5432/insightops
DATABASE_RW_URL=postgresql://analytics_rw:analytics_rw_pass@localhost:5432/insightops

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM
ANTHROPIC_API_KEY=sk-ant-...
LITELLM_MODEL_COMPLEX=claude-sonnet-4-20250514
LITELLM_MODEL_SIMPLE=claude-3-5-haiku-20241022
ROUTING_ENABLED=true

# Mem0
MEM0_API_KEY=
MEM0_USER_ID=default

# Langfuse (optional)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# App
APP_ENV=development
CHARTS_DIR=charts
APPROVALS_ENABLED=true
